# =============================================================================
# admin-web environment variables
# =============================================================================
#
# VERCEL (recommended — embedded backend, same origin):
#   1. Do NOT set NEXT_PUBLIC_ADMIN_API_BASE_URL (leave unset).
#   2. Do NOT set ADMIN_API_PROXY_TARGET unless you have a working AWS incloser-node URL.
#   3. Set these on the Vercel project (Settings → Environment Variables):
#        JWT_SECRET=...                    (≥16 chars)
#        SUPABASE_URL=https://xxx.supabase.co
#        SUPABASE_SERVICE_ROLE_KEY=...     (service_role, not anon)
#   4. Redeploy after changing env vars.
#
# The browser always calls /api/admin-backend on the same site. No CORS setup needed.
#
# AWS proxy (optional — only if incloser-node is deployed and reachable):
#   ADMIN_API_PROXY_TARGET=https://your-aws-alb-or-domain   (no trailing slash)
#   Remove JWT_SECRET / SUPABASE_* from Vercel if the backend holds them instead.
#   Still do NOT set NEXT_PUBLIC_ADMIN_API_BASE_URL unless you also configure CORS on AWS.
# =============================================================================

# --- External backend proxy (optional) -----------------------------------------
# Proxies browser /api/admin-backend/* → ${ADMIN_API_PROXY_TARGET}/api/admin/*
# ADMIN_API_PROXY_TARGET=

# --- Embedded backend (default on Vercel) --------------------------------------
# JWT_SECRET=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Browser-only override (usually wrong on Vercel — avoid) -----------------
# Calling localhost or a dead URL here causes "Could not reach the admin API".
# NEXT_PUBLIC_ADMIN_API_BASE_URL=
